{
  "name": "siyuan-exam",
  "version": "0.7.7",
  "type": "module",
  "description": "小驴考试 (Lv Exam) — SiYuan exam question bank learning: import, practice, mock exam, wrongbook, FSRS flashcards, AI. 思源笔记本地题库学习管理插件",
  "repository": "https://github.com/ai68298100/siyuan-exam",
  "homepage": "https://github.com/ai68298100/siyuan-exam",
  "author": "ai68298100",
  "license": "MIT",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm run dev:app",
    "dev:app": "cross-env NODE_ENV=development VITE_SOURCEMAP=inline VITE_BUILD_TARGET=app vite build --watch",
    "check": "run-s check:types check:svelte check:i18n check:arch check:styles",
    "guard": "run-s check:types check:svelte check:i18n check:arch check:styles lint test",
    "preflight": "node ./scripts/smoke-preflight.mjs",
    "smoke": "run-s preflight smoke:data smoke:csv perf:bank",
    "smoke:data": "node ./scripts/smoke-data.mjs",
    "smoke:csv": "node ./scripts/smoke-csv.mjs",
    "perf:bank": "node ./scripts/perf-bank.mjs",
    "e2e": "node ./scripts/smoke-e2e.mjs",
    "check:styles": "node ./scripts/check-styles.mjs",
    "commit:check": "commitlint",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:i18n": "node ./scripts/check-i18n.mjs",
    "check:arch": "node ./scripts/check-arch.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:package": "node ./scripts/verify-package.mjs",
    "release:check": "node ./scripts/release-check.mjs",
    "check:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "clean": "node ./scripts/clean.js",
    "build": "run-s clean build:app",
    "build:app": "cross-env NODE_ENV=production VITE_BUILD_TARGET=app vite build",
    "make-link": "node --no-warnings ./scripts/make_dev_link.js",
    "make-link-win": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/elevate.ps1 -scriptPath ./scripts/make_dev_link.js",
    "update-version": "node --no-warnings ./scripts/update_version.js",
    "make-install": "pnpm run build && node --no-warnings ./scripts/make_install.js"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/livereload": "^0.9.5",
    "@types/minimist": "^1.2.5",
    "@types/node": "^26.6.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "fast-glob": "^3.3.3",
    "glob": "^13.0.6",
    "globals": "^17.13.0",
    "js-yaml": "^5.4.2",
    "jsdom": "^30.1.2",
    "livereload": "^0.10.3",
    "minimist": "^1.2.8",
    "npm-run-all": "^4.1.5",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "sass": "^1.105.1",
    "siyuan": "1.2.9",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-plugin-zip-pack": "^1.2.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  }
}
